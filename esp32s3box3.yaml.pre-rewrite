            int bri = id(chakra_light_bri);
            if(bri > 0) it.filled_rectangle(38, 133, (int)(244.0f * bri / 100.0f), 20, id(ha_blue));
          }
          it.printf(160, 134, id(my_font5), id(black), TextAlign::TOP_CENTER, "%.0f%%", (float)id(chakra_light_bri));
          it.filled_rectangle(284, 128, 36, 30, id(ha_blue));
          it.printf(302, 132, id(my_font5), id(white), TextAlign::TOP_CENTER, "+");
          // ── 7 Chakra color swatches (y=162-187) ──────────────────────
          {
            static const int sw_x[7] = {0, 46, 91, 137, 183, 228, 274};
            static const int sw_w[7] = {46, 45, 46, 46, 45, 46, 46};
            int cidx_l = id(chakra_index);
            bool mode_l = id(chakra_mode_active);
            for (int i = 0; i < 7; i++) {
              const ChakraInfo& ci = ChakraAnalyser::get_info(i);
              Color cc(ci.r, ci.g, ci.b);
              it.filled_rectangle(sw_x[i], 162, sw_w[i], 25, cc);
              bool dark_bg = ((int)ci.r + (int)ci.g + (int)ci.b) < 400;
              Color txt_col = dark_bg ? id(white) : id(black);
              it.printf(sw_x[i] + sw_w[i]/2, 164, id(my_font), txt_col, TextAlign::TOP_CENTER, "%d", i+1);
              if (i == cidx_l && mode_l) {
                it.rectangle(sw_x[i], 162, sw_w[i], 25, id(white));
                it.rectangle(sw_x[i]+1, 163, sw_w[i]-2, 23, id(white));
              }
            }
          }
          // ── Color temperature row (y=191-222, 31px) ─────────────────────
          it.filled_rectangle(0,   191, 106, 31, Color(255, 180, 80));
          it.filled_rectangle(107, 191, 107, 31, Color(220, 220, 200));
          it.filled_rectangle(215, 191, 105, 31, Color(180, 220, 255));
          it.printf(53,  206, id(my_font5), id(black), TextAlign::CENTER, "WARM");
          it.printf(160, 206, id(my_font5), id(black), TextAlign::CENTER, "NEUTRAL");
          it.printf(267, 206, id(my_font5), id(black), TextAlign::CENTER, "COOL");

          // ── Branding footer ─────────────────────────────────────────
          it.filled_rectangle(0, 224, 320, 16, id(ha_blue));
          it.printf(160, 225, id(my_font12), id(white), TextAlign::TOP_CENTER, "Sound Healing Assistant by Captain Leopard");

