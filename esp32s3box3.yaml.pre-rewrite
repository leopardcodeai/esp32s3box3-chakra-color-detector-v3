      - id: saver_page ##### screen saver display page #####
        lambda: |-
          // ── Full dark-blue background (matches clock_page; brightness dimmed by backlight) ──
          it.filled_rectangle(0, 0, 320, 240, id(ha_blue));
          const char *days[] {"${sunday}","${monday}","${tuesday}","${wednesday}","${thursday}","${friday}","${saturday}"};
          it.printf(160, 8, id(my_font5), light_blue, TextAlign::TOP_CENTER,
            "%s", days[id(ha_time).now().day_of_week - 1]);
          if(id(time_display_format).state == "24 Hr") {
            it.strftime(160, 35, id(my_font2), id(white), TextAlign::TOP_CENTER, "%H:%M:%S", id(ha_time).now());
          } else {
            it.strftime(160, 35, id(my_font2), id(white), TextAlign::TOP_CENTER, "%l:%M:%S", id(ha_time).now());
          }
          it.printf(160, 130, id(my_font3), id(white), TextAlign::TOP_CENTER,
            "%02d.%02d.%02d",
            id(ha_time).now().day_of_month,
            id(ha_time).now().month,
            id(ha_time).now().year % 100);
          it.filled_rectangle(40, 168, 240, 2, light_blue);
          it.printf(160, 175, id(my_font5), light_blue, TextAlign::TOP_CENTER, "${timezone}");
          it.printf(80, 198, id(my_font5), id(white), TextAlign::TOP_CENTER,
            "%.1f\xC2\xB0C", id(s3temp).state);
          it.printf(240, 198, id(my_font5), id(white), TextAlign::TOP_CENTER,
            "%.1f%%", id(s3humidity).state);

          // ── Branding footer ─────────────────────────────────────────
          it.filled_rectangle(0, 224, 320, 16, id(ha_blue));
          it.printf(160, 225, id(my_font12), id(white), TextAlign::TOP_CENTER, "Sound Healing Assistant by Captain Leopard");

