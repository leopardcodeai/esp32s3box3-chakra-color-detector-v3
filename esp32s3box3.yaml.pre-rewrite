                 ? id(lime)
                 : Color(id(chakra_ha_r), id(chakra_ha_g), id(chakra_ha_b)))
              : id(white);
            it.printf(35, 68, id(icon_font_55), bulb_col, TextAlign::TOP_CENTER,
              on ? "\U000F1253" : "\U000F12CD");
