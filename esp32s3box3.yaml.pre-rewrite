color:
  - id: green
    hex: '75D15F'
  - id: red
    hex: 'FF3131'
  - id: blue
    hex: '47B7E9'
  - id: blue_drk
    hex: '085296'
  - id: amber
    hex: 'FBAB35'
  - id: orange
    hex: 'FF6B00'
  - id: lime
    hex: '20FC30'
  - id: pink
    hex: 'D92BBC'
  - id: yellow
    hex: 'FFC000'
  - id: black
    hex: ${display_text_hex}    # configurable via device_config.yaml (default: '000000')
  - id: white
    hex: 'ffffff'               # always true white — used for highlights & chakra text
  - id: display_bg
    hex: ${display_bg_hex}      # configurable via device_config.yaml (default: 'ffffff')
  - id: purple
    hex: '73264D'
  - id: light_blue
    hex: '1565C0'
  - id: bg_blue
    hex: '032341'
  - id: bg_purple
    hex: '301020'
  - id: bg_green
    hex: '05350B'
  - id: bg_red
    hex: '3C0000'
  - id: bg_pink
    hex: '61034D'
  - id: bg_charcoal
    hex: '323232'
  - id: bg_brown
    hex: '41220D'
  - id: bg_grey
    hex: '4F4F4F'
  - id: status_bar_grey
    hex: 'EBEBEB'
  - id: ha_blue
    hex: '41BDF5'

spi:
  clk_pin: 7
  mosi_pin: 6


display:
  - platform: ili9xxx
    id: s3_box_lcd
    model: S3BOX
    data_rate: 40MHz
    cs_pin: 5
    dc_pin: 4
    reset_pin:
      number: 48
      inverted: true
    update_interval: never
    invert_colors: false
    ##################################################################################################
    ################ The below section defines, what is displayed on the screen,        ##############
    ################ the colours and mdi icons are defined above under font: and Color: ##############
    ################ they are then referenced in the config below.                      ##############
    ##################################################################################################
    pages:
      - id: idle_page ##### home page ######
        lambda: |-
          it.fill(id(display_bg));
          it.filled_rectangle(0, 0, 320, 55, id(ha_blue));
          if(id(api_connection) == true) {
          it.printf(5, 5, id(icon_font_55), id(white), "\U000F07D0");
          } else {
                  it.printf(5, 5, id(icon_font_55), red, "\U000F087B");
          }
          if(id(wifi_connection) == true) {
                  it.printf(58, 5, id(icon_font_55), lime, "\U000F16BD");
          } else {
                  it.printf(58, 5, id(icon_font_55), red, "\U000F16BC");
          }
          it.printf(85, 28, id(my_font16), Color(160,160,160), TextAlign::CENTER, "%.0f%%", id(wifi_percent).state);
          if(id(mute_switch).state) {
                 it.printf(111, 5, id(icon_font_55), red, "\U000F036D");
          } else {
                 it.printf(111, 5, id(icon_font_55), lime, "\U000F036C");
          }
          {
            bool _cha_hdr = id(chakra_mode_active);
            it.printf(164, 5, id(icon_font_55), _cha_hdr ? id(lime) : id(white), "\U000F0617");
          }
          {
            bool _lamp_on = id(ha_light_entity_state).state == "on";
            Color _lamp_col = _lamp_on
              ? ((id(chakra_ha_r) == 0 && id(chakra_ha_g) == 0 && id(chakra_ha_b) == 0)
                 ? id(lime)
                 : Color(id(chakra_ha_r), id(chakra_ha_g), id(chakra_ha_b)))
              : id(white);
            it.printf(217, 5, id(icon_font_55), _lamp_col, "\U000F0335");
            it.printf(244, 28, id(my_font16), Color(160,160,160), TextAlign::CENTER, "%.0f%%", (float)id(chakra_light_bri));
          }
          // Battery icon top-right (always lime, no % overlay)
          {
            float bat = id(battery_percent).state;
            const char* bat_icon;
            if      (bat >= 95) bat_icon = "\U000F0079";
            else if (bat >= 85) bat_icon = "\U000F0082";
            else if (bat >= 75) bat_icon = "\U000F0081";
            else if (bat >= 65) bat_icon = "\U000F0080";
            else if (bat >= 55) bat_icon = "\U000F007F";
            else if (bat >= 45) bat_icon = "\U000F007E";
            else if (bat >= 35) bat_icon = "\U000F007D";
            else if (bat >= 25) bat_icon = "\U000F007C";
            else if (bat >= 15) bat_icon = "\U000F007B";
            else if (bat >= 5)  bat_icon = "\U000F007A";
            else                bat_icon = "\U000F10CD";
            it.printf(272, 5, id(icon_font_55), id(lime), bat_icon);
            it.printf(299, 28, id(my_font16), Color(160,160,160), TextAlign::CENTER, "%.0f%%", bat);
          }
          // ── Grid dividers ──────────────────────────────────────────────
          it.filled_rectangle(107, 55, 1, 169, Color(80,80,80));
          it.filled_rectangle(214, 55, 1, 169, Color(80,80,80));
          it.filled_rectangle(0, 139, 320, 1, Color(80,80,80));
          // ── Row 1: Thermometer | Lamp | Chakra ─────────────────────────
          it.printf(16, 60, id(icon_font_80), id(ha_blue), "\U000F050F");
          it.printf(53, 100, id(my_font5), Color(160,160,160), TextAlign::CENTER, "%.1f\xC2\xB0C", id(s3temp).state);
          it.printf(53, 116, id(my_font5), Color(160,160,160), TextAlign::CENTER, "%.0f%%", id(s3humidity).state);
          {
            bool lamp_on = id(ha_light_entity_state).state == "on";
            Color idle_lamp_col = lamp_on
              ? ((id(chakra_ha_r) == 0 && id(chakra_ha_g) == 0 && id(chakra_ha_b) == 0)
                 ? id(lime)
                 : Color(id(chakra_ha_r), id(chakra_ha_g), id(chakra_ha_b)))
              : id(white);
            it.printf(123, 60, id(icon_font_80), idle_lamp_col,
              lamp_on ? "\U000F1253" : "\U000F12CD");
            it.printf(160, 105, id(my_font5), Color(160,160,160), TextAlign::CENTER, "%.0f%%", (float)id(chakra_light_bri));
          }
          {
            bool cha_on = id(chakra_mode_active);
            it.printf(230, 60, id(icon_font_80), cha_on ? id(lime) : id(ha_blue), "\U000F0617");
            it.printf(267, 97, id(my_font5), Color(140,140,140), TextAlign::CENTER,
              cha_on ? "ON" : "OFF");
          }
          // ── Row 2: Music | Clock | Settings ───────────────────────────
          it.printf(16, 144, id(icon_font_80), id(ha_blue), "\U000F075A");
          if(id(time_display_format).state == "24 Hr") {
            it.strftime(160, 163, id(my_font4), id(ha_blue), TextAlign::TOP_CENTER, "%H:%M", id(ha_time).now());
          } else {
            it.strftime(160, 163, id(my_font4), id(ha_blue), TextAlign::TOP_CENTER, "%l:%M", id(ha_time).now());
          }
          it.strftime(160, 208, id(my_font16), id(ha_blue), TextAlign::TOP_CENTER, "%d.%m.%y", id(ha_time).now());
          it.printf(230, 144, id(icon_font_80), id(ha_blue), "\U000F08D6");

          // ── Branding footer ─────────────────────────────────────────
          it.filled_rectangle(0, 224, 320, 16, id(ha_blue));
          it.printf(160, 225, id(my_font12), id(white), TextAlign::TOP_CENTER, "Sound Healing Assistant by Captain Leopard");

      - id: clock_page ##### clock page #####
        lambda: |-
          // ── Full dark-blue background ──────────────────────────────────
          it.filled_rectangle(0, 0, 320, 240, id(ha_blue));
          // ── Day of week (top, small) ───────────────────────────────────
          const char *days[]   {"${sunday}","${monday}","${tuesday}","${wednesday}","${thursday}","${friday}","${saturday}"};
          it.printf(160, 8, id(my_font5), light_blue, TextAlign::TOP_CENTER,
            "%s", days[id(ha_time).now().day_of_week - 1]);
          // ── Large time HH:MM:SS (centered) ────────────────────────────
          if(id(time_display_format).state == "24 Hr") {
            it.strftime(160, 35, id(my_font2), id(white), TextAlign::TOP_CENTER, "%H:%M:%S", id(ha_time).now());
          } else {
            it.strftime(160, 35, id(my_font2), id(white), TextAlign::TOP_CENTER, "%l:%M:%S", id(ha_time).now());
          }
          // ── Full date DD.MM.YY ────────────────────────────────────────
          it.printf(160, 130, id(my_font3), id(white), TextAlign::TOP_CENTER,
            "%02d.%02d.%02d",
            id(ha_time).now().day_of_month,
            id(ha_time).now().month,
            id(ha_time).now().year % 100);
          // ── Divider ────────────────────────────────────────────────────
          it.filled_rectangle(40, 168, 240, 2, light_blue);
          // ── Timezone label ─────────────────────────────────────────────
          it.printf(160, 175, id(my_font5), light_blue, TextAlign::TOP_CENTER, "${timezone}");
          // ── Temp + Humidity ────────────────────────────────────────────
          it.printf(80, 198, id(my_font5), id(white), TextAlign::TOP_CENTER,
            "%.1f\xC2\xB0C", id(s3temp).state);
          it.printf(240, 198, id(my_font5), id(white), TextAlign::TOP_CENTER,
            "%.1f%%", id(s3humidity).state);

          // ── Branding footer ─────────────────────────────────────────
          it.filled_rectangle(0, 224, 320, 16, id(ha_blue));
          it.printf(160, 225, id(my_font12), id(white), TextAlign::TOP_CENTER, "Sound Healing Assistant by Captain Leopard");

      - id: info_page ##### info page #####
        lambda: |-
          it.fill(id(display_bg));
          it.filled_rectangle(0, 0, 320, 55, id(ha_blue));
          if(id(api_connection) == true) {
                  it.printf(5, 5, id(icon_font_55), id(white), "\U000F07D0");
          } else {
                  it.printf(5, 5, id(icon_font_55), red, "\U000F087B");
          }
          if(id(wifi_connection) == true) {
                  it.printf(58, 5, id(icon_font_55), lime, "\U000F16BD");
          } else {
                  it.printf(58, 5, id(icon_font_55), red, "\U000F16BC");
          }
          it.printf(85, 28, id(my_font16), Color(160,160,160), TextAlign::CENTER, "%.0f%%", id(wifi_percent).state);
          if(id(mute_switch).state) {
                 it.printf(111, 5, id(icon_font_55), red, "\U000F036D");
          } else {
                 it.printf(111, 5, id(icon_font_55), lime, "\U000F036C");
          }
          {
            bool _cha_hdr = id(chakra_mode_active);
            it.printf(164, 5, id(icon_font_55), _cha_hdr ? id(lime) : id(white), "\U000F0617");
          }
          {
            bool _lamp_on = id(ha_light_entity_state).state == "on";
            Color _lamp_col = _lamp_on
              ? ((id(chakra_ha_r) == 0 && id(chakra_ha_g) == 0 && id(chakra_ha_b) == 0)
                 ? id(lime)
                 : Color(id(chakra_ha_r), id(chakra_ha_g), id(chakra_ha_b)))
              : id(white);
            it.printf(217, 5, id(icon_font_55), _lamp_col, "\U000F0335");
            it.printf(244, 28, id(my_font16), Color(160,160,160), TextAlign::CENTER, "%.0f%%", (float)id(chakra_light_bri));
          }
          // Battery icon top-right (always lime, no % overlay)
          {
            float bat = id(battery_percent).state;
            const char* bat_icon;
            if      (bat >= 95) bat_icon = "\U000F0079";
            else if (bat >= 85) bat_icon = "\U000F0082";
            else if (bat >= 75) bat_icon = "\U000F0081";
            else if (bat >= 65) bat_icon = "\U000F0080";
            else if (bat >= 55) bat_icon = "\U000F007F";
            else if (bat >= 45) bat_icon = "\U000F007E";
            else if (bat >= 35) bat_icon = "\U000F007D";
            else if (bat >= 25) bat_icon = "\U000F007C";
            else if (bat >= 15) bat_icon = "\U000F007B";
            else if (bat >= 5)  bat_icon = "\U000F007A";
            else                bat_icon = "\U000F10CD";
            it.printf(272, 5, id(icon_font_55), id(lime), bat_icon);
            it.printf(299, 28, id(my_font16), Color(160,160,160), TextAlign::CENTER, "%.0f%%", bat);
          }
          // ── Page title ───────────────────────────────────────────────
          it.printf(160, 56, id(my_font5), id(ha_blue), TextAlign::TOP_CENTER, "DEVICE INFO");
          // ── Info rows ─────────────────────────────────────────────────
          it.printf(155, 78, id(my_font5), light_blue, TextAlign::RIGHT, "IP Address:");
          it.printf(165, 78, id(my_font5), yellow, TextAlign::LEFT, "%s", id(ip_addr).state.c_str());
          it.printf(155, 103, id(my_font5), light_blue, TextAlign::RIGHT, "Host Name:");
          it.printf(165, 103, id(my_font5), yellow, TextAlign::LEFT, "${name}.local");
          it.printf(155, 128, id(my_font5), light_blue, TextAlign::RIGHT, "Uptime:");
          it.printf(165, 128, id(my_font5), yellow, TextAlign::LEFT, "%s", id(up_sens_text).state.c_str());
          it.printf(155, 153, id(my_font5), light_blue, TextAlign::RIGHT, "Battery:");
          it.printf(165, 153, id(my_font5), yellow, TextAlign::LEFT, "%.0f%%", id(battery_percent).state);


          // ── Branding footer ─────────────────────────────────────────
          it.filled_rectangle(0, 224, 320, 16, id(ha_blue));
          it.printf(160, 225, id(my_font12), id(white), TextAlign::TOP_CENTER, "Sound Healing Assistant by Captain Leopard");

      - id: ss_set_page ##### screen saver settings page #####
        lambda: |-
          it.fill(id(display_bg));
          it.filled_rectangle(0, 0, 320, 55, id(ha_blue));
          if(id(api_connection) == true) {
                  it.printf(5, 5, id(icon_font_55), id(white), "\U000F07D0");
