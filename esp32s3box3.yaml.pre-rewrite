##### media player #####
  - platform: touchscreen
    page_id: media_page
    name: Prev Track
    internal: true
    x_min: 5
    x_max: 106
    y_min: 92
    y_max: 157
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - if:
            condition:
              switch.is_on: output_audio
            then:
              - homeassistant.service:
                  service: media_player.media_previous_track
                  data:
                    entity_id: media_player.${external_media_player}
            else:
              - homeassistant.service:
                  service: media_player.media_previous_track
                  data:
                    entity_id: media_player.${friendly_name}
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: media_page
    name: Next Track
    internal: true
    x_min: 215
    x_max: 315
    y_min: 92
    y_max: 157
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - if:
            condition:
              switch.is_on: output_audio
            then:
              - homeassistant.service:
                  service: media_player.media_next_track
                  data:
                    entity_id: media_player.${external_media_player}
            else:
              - homeassistant.service:
                  service: media_player.media_next_track
                  data:
                    entity_id: media_player.${friendly_name}
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: media_page
    name: Play Pause
    internal: true
    x_min: 108
    x_max: 213
    y_min: 92
    y_max: 157
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - if:
            condition:
              switch.is_on: output_audio
            then:
              - homeassistant.service:
                  service: media_player.media_play_pause
                  data:
                    entity_id: media_player.${external_media_player}
            else:
              - if:
                  condition:
                    media_player.is_idle:
                  then:
                    - media_player.play
                  else:
                    - media_player.stop
        - logger.log: "Play Pause pressed"

  - platform: touchscreen
    page_id: media_page
    name: Volume Minus
    internal: true
    x_min: 5
    x_max: 106
    y_min: 158
    y_max: 223
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - if:
            condition:
              switch.is_on: output_audio
            then:
              - homeassistant.service:
                  service: media_player.volume_down
                  data:
                    entity_id: media_player.${external_media_player}
            else:
              - logger.log: "Volume Minus pressed"
              - lambda: |-
                  if (id(speaker_volume) > 0) {
                    id(speaker_volume) -= 1;
                  }
              - script.execute: set_volume
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: media_page
    name: Volume Plus
    internal: true
    x_min: 215
    x_max: 315
    y_min: 158
    y_max: 223
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - if:
            condition:
              switch.is_on: output_audio
            then:
              - homeassistant.service:
                  service: media_player.volume_up
                  data:
                    entity_id: media_player.${external_media_player}
            else:
              - logger.log: "Volume Plus pressed"
              - lambda: |-
                  if (id(speaker_volume) < 10) {
                    id(speaker_volume) += 1;
                  }
              - script.execute: set_volume
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: media_page
    name: Mute Media
    internal: true
    x_min: 108
    x_max: 213
    y_min: 158
    y_max: 223
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - if:
            condition:
              switch.is_on: output_audio
            then:
              - switch.toggle: ext_media_mute
            else:
              - switch.toggle: media_mute
        - component.update: s3_box_lcd

  # Toggle INT/EXT mode directly on media page
  - platform: touchscreen
    page_id: media_page
    id: media_output_toggle
    internal: true
    x_min: 240
    x_max: 315
    y_min: 55
    y_max: 95
    on_click:
      min_length: 0ms
      max_length: 500ms
      then:
        - switch.toggle: output_audio
        - component.update: s3_box_lcd

        - script.execute: set_volume

