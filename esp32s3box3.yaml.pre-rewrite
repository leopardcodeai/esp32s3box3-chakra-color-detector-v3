##### touch to wake screen #####
  - platform: touchscreen
    page_id: saver_page
    id: ss_wake
    internal: true
    x_min: 0
    x_max: 320
    y_min: 0
    y_max: 240
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - display.page.show: idle_page
        - component.update: s3_box_lcd

##### device settings page #####
  - id: s_default_bright_down
    page_id: device_set_page
    platform: touchscreen
    internal: true
    x_min: 280
    x_max: 320
    y_min: 70
    y_max: 110
    on_press:
      then:
        - lambda: |-
            int default_bright = id(s_default_brightness).state - 5;
            if (default_bright < 1) {
              default_bright = 1;
            }
            auto call = id(s_default_brightness).make_call();
            call.set_value(default_bright);
            call.perform();
        - component.update: s3_box_lcd

  - id: s_default_bright_up
    page_id: device_set_page
    platform: touchscreen
    internal: true
    x_min: 155
    x_max: 195
    y_min: 70
    y_max: 110
    on_press:
      then:
        - lambda: |-
            int default_bright = id(s_default_brightness).state + 5;
            auto call = id(s_default_brightness).make_call();
            call.set_value(default_bright);
            call.perform();
        - component.update: s3_box_lcd



  - platform: touchscreen
    page_id: device_set_page
    id: chang_display_format
    x_min: 200
    x_max: 310
    y_min: 125
    y_max: 155
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - select.operation:
            id: time_format
            operation: Next
            cycle: true
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: device_set_page
    id: temp_offset_minus
    internal: true
    x_min: 230
    x_max: 260
    y_min: 155
    y_max: 179
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            auto call = id(temp_offset).make_call();
            call.set_value(id(temp_offset).state - 0.5f);
            call.perform();
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: device_set_page
    id: temp_offset_plus
    internal: true
    x_min: 262
    x_max: 292
    y_min: 155
    y_max: 179
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            auto call = id(temp_offset).make_call();
            call.set_value(id(temp_offset).state + 0.5f);
            call.perform();
        - component.update: s3_box_lcd



################## Chakra Page Touch Buttons ###########################
  # Threshold minus button (x 0-30, y 172-208)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_thr_minus
    internal: true
    x_min: 0
    x_max: 30
    y_min: 172
    y_max: 223
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            float v = id(chakra_detection_threshold) - 0.001f;
            if (v < 0.0001f) v = 0.0001f;
            id(chakra_detection_threshold) = v;
        - component.update: s3_box_lcd

  # Threshold plus button (x 77-107, y 172-208)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_thr_plus
    internal: true
    x_min: 77
    x_max: 107
    y_min: 172
    y_max: 223
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            float v = id(chakra_detection_threshold) + 0.001f;
            if (v > 0.10f) v = 0.10f;
            id(chakra_detection_threshold) = v;
        - component.update: s3_box_lcd

  # Hold minus button (x 109-139, y 172-208)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_hold_minus
    internal: true
    x_min: 109
    x_max: 139
    y_min: 172
    y_max: 223
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            int v = id(chakra_hold_frames) - 2;
            if (v < 0) v = 0;
            id(chakra_hold_frames) = v;
        - component.update: s3_box_lcd

  # Hold plus button (x 184-214, y 172-208)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_hold_plus
    internal: true
    x_min: 184
    x_max: 214
    y_min: 172
    y_max: 223
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            int v = id(chakra_hold_frames) + 2;
            if (v > 30) v = 30;
            id(chakra_hold_frames) = v;
        - component.update: s3_box_lcd

  # Light brightness minus (x 215-245, y 172-208)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_bri_minus
    internal: true
    x_min: 215
    x_max: 245
    y_min: 172
    y_max: 223
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            int v = id(chakra_light_bri) - 10;
            if (v < 0) v = 0;
            id(chakra_light_bri) = v;
        - component.update: s3_box_lcd

  # Light brightness plus (x 289-319, y 172-208)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_bri_plus
    internal: true
    x_min: 289
    x_max: 319
    y_min: 172
    y_max: 223
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - lambda: |-
            int v = id(chakra_light_bri) + 10;
            if (v > 100) v = 100;
            id(chakra_light_bri) = v;
        - component.update: s3_box_lcd


  # ON/OFF bar (full-width, y=210-222)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_onoff_bar
    internal: true
    x_min: 2
    x_max: 318
    y_min: 210
    y_max: 222
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - if:
            condition:
              lambda: return !id(chakra_transitioning);
            then:
              - switch.toggle: chakra_mode_switch

  # Toggle switch (title band, x=2-64, y=0-30)
  - platform: touchscreen
    page_id: chakra_page
    id: chakra_title_toggle
    internal: true
    x_min: 2
    x_max: 64
    y_min: 0
    y_max: 30
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - if:
            condition:
              lambda: return !id(chakra_transitioning);
            then:
              - switch.toggle: chakra_mode_switch

