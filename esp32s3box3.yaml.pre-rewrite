    y_max: 55
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - switch.toggle: mute_switch
        - component.update: s3_box_lcd

  - platform: touchscreen
    pages:
      - idle_page
      - info_page
      - lights_page
      - clock_page
      - media_page
      - scenes_page
      - device_set_page
      - settings_page
      - chakra_set_page
    id: status_bar_4
    internal: true
    x_min: 159
    x_max: 211
    y_min: 0
