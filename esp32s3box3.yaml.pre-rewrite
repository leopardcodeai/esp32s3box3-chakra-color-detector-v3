      min_length: 10ms
      max_length: 500ms
      then:
        - if:
            condition:
              lambda: return !id(chakra_transitioning);
            then:
              - switch.toggle: chakra_mode_switch
              - component.update: s3_box_lcd

  - platform: touchscreen
    pages:
      - idle_page
      - info_page
      - lights_page
      - clock_page
      - media_page
      - scenes_page
