##### lights page #####
  - platform: touchscreen
    page_id: lights_page
    id: lights1
    internal: true
    x_min: 5
    x_max: 155
    y_min: 60
    y_max: 135
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - if:
            condition:
              lambda: 'return id(ha_light_entity_state).state == "on";'
            then:
              - homeassistant.service:
                  service: light.turn_off
                  data:
                    entity_id: light.${chakra_light_entity}
            else:
              - homeassistant.service:
                  service: light.turn_on
                  data:
                    entity_id: light.${chakra_light_entity}
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: lights_page
    id: lights_bri_minus
    internal: true
    x_min: 0
    x_max: 36
    y_min: 128
    y_max: 158
    on_press:
      then:
        - lambda: |-
            int v = id(chakra_light_bri) - 10;
            if(v < 5) v = 5;
            id(chakra_light_bri) = v;
        - homeassistant.service:
            service: light.turn_on
            data:
              entity_id: light.${chakra_light_entity}
            data_template:
              brightness_pct: "{{ chakra_bri }}"
            variables:
              chakra_bri: !lambda 'return std::to_string(id(chakra_light_bri));'
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: lights_page
    id: lights_bri_plus
    internal: true
    x_min: 284
    x_max: 320
    y_min: 128
    y_max: 158
    on_press:
      then:
        - lambda: |-
            int v = id(chakra_light_bri) + 10;
            if(v > 100) v = 100;
            id(chakra_light_bri) = v;
        - homeassistant.service:
            service: light.turn_on
            data:
              entity_id: light.${chakra_light_entity}
            data_template:
              brightness_pct: "{{ chakra_bri }}"
            variables:
              chakra_bri: !lambda 'return std::to_string(id(chakra_light_bri));'
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: lights_page
    id: lights_warm
    internal: true
    x_min: 0
    x_max: 106
    y_min: 191
    y_max: 222
    on_click:
      min_length: 10ms
      max_length: 500ms
      then:
        - homeassistant.service:
            service: light.turn_on
            data:
              entity_id: light.${chakra_light_entity}
              color_temp_kelvin: "2700"
        - component.update: s3_box_lcd

  - platform: touchscreen
    page_id: lights_page
